<file path="public/css/style.css">
/* ============ RESET ============ */
* { margin:0; padding:0; box-sizing:border-box; }

:root{
  --ink:#0a0a0a;
  --paper:#ffffff;
  --teal:#28e2c8;
  --teal-dark:#14b39d;
  --gray-50:#fafafa;
  --gray-100:#f2f2f0;
  --gray-300:#d8d8d4;
  --gray-500:#8a8a86;
  --gray-700:#4a4a47;
  --border:rgba(10,10,10,0.12);
  --ease:0.2s ease;
}

html{ scroll-behavior:smooth; }

body{
  font-family:'Inter', sans-serif;
  background:var(--paper);
  color:var(--ink);
  line-height:1.6;
  -webkit-font-smoothing:antialiased;
}

h1,h2,h3,h4,.logo,.btn,.eyebrow{ font-family:'Space Grotesk', sans-serif; }

.container{ max-width:1160px; margin:0 auto; padding:0 32px; }

a{ text-decoration:none; color:inherit; }
img{ max-width:100%; display:block; }
ul{ list-style:none; }

::selection{ background:var(--teal); color:var(--ink); }

/* ============ SIGNATURE: TEAL SQUARE MARK ============ */
.mark{
  display:inline-block;
  width:8px; height:8px;
  background:var(--teal);
  flex-shrink:0;
}

/* ============ BUTTONS ============ */
.btn{
  display:inline-flex;
  align-items:center;
  gap:10px;
  padding:15px 30px;
  font-weight:500;
  font-size:0.95rem;
  border:1px solid var(--ink);
  cursor:pointer;
  transition:var(--ease);
  letter-spacing:0.01em;
}
.btn-primary{
  background:var(--ink);
  color:var(--paper);
}
.btn-primary:hover{ background:var(--teal-dark); border-color:var(--teal-dark); color:var(--ink); }

.btn-outline{
  background:transparent;
  color:var(--ink);
}
.btn-outline:hover{ background:var(--ink); color:var(--paper); }

/* ============ HEADER ============ */
header{
  padding:0;
  border-bottom:1px solid var(--border);
  position:sticky;
  top:0;
  background:rgba(255,255,255,0.92);
  backdrop-filter:blur(6px);
  z-index:100;
}
.header-content{
  display:flex;
  justify-content:space-between;
  align-items:center;
  height:76px;
}
.logo{
  font-size:1.4rem;
  font-weight:600;
  color:var(--ink);
  letter-spacing:-0.02em;
  display:flex;
  align-items:center;
  gap:6px;
}
.logo img{ height:150px; width:auto; }

.nav-links{
  display:flex;
  gap:40px;
  align-items:center;
}
.nav-links a:not(.btn){
  font-family:'Inter', sans-serif;
  font-weight:500;
  font-size:0.9rem;
  color:var(--gray-700);
  transition:var(--ease);
}
.nav-links a:not(.btn):hover{ color:var(--ink); }
.nav-links .btn{ padding:11px 24px; font-size:0.88rem; }

.menu-toggle{
  display:none;
  font-size:1.4rem;
  background:none;
  border:none;
  color:var(--ink);
  cursor:pointer;
}

/* ============ HERO ============ */
.hero{ padding:100px 0 90px; border-bottom:1px solid var(--border); }
.hero-grid{
  display:grid;
  grid-template-columns:1.1fr 0.9fr;
  gap:70px;
  align-items:center;
}
.eyebrow{
  display:flex;
  align-items:center;
  gap:10px;
  font-size:0.8rem;
  font-weight:600;
  letter-spacing:0.08em;
  text-transform:uppercase;
  color:var(--gray-700);
  margin-bottom:28px;
}
.hero-content h1{
  font-size:3.4rem;
  font-weight:600;
  line-height:1.08;
  letter-spacing:-0.02em;
  color:var(--ink);
  margin-bottom:26px;
}
.hero-content h1 em{
  font-style:normal;
  color:var(--teal-dark);
}
.hero-content p{
  font-family:'Inter', sans-serif;
  font-size:1.1rem;
  color:var(--gray-700);
  max-width:460px;
  margin-bottom:36px;
}
.hero-buttons{ display:flex; gap:14px; flex-wrap:wrap; margin-bottom:32px; }
.hero-note{
  display:flex;
  align-items:center;
  gap:8px;
  font-size:0.85rem;
  color:var(--gray-500);
}

/* --- hero visual: system grid --- */
.hero-visual{
  aspect-ratio:1/1;
  border:1px solid var(--border);
  padding:24px;
  display:grid;
  grid-template-columns:repeat(6,1fr);
  grid-template-rows:repeat(6,1fr);
  gap:6px;
}
.hv-cell{ background:var(--gray-100); transition:background var(--ease); }
.hv-cell.on{ background:var(--ink); }
.hv-cell.teal{ background:var(--teal); }

/* ============ SECTIONS ============ */
.section{ padding:100px 0; border-bottom:1px solid var(--border); }
.section-head{ max-width:640px; margin-bottom:56px; }
.section-head.center{ margin-left:auto; margin-right:auto; text-align:center; }
.section-label{
  display:flex;
  align-items:center;
  gap:10px;
  font-size:0.8rem;
  font-weight:600;
  letter-spacing:0.08em;
  text-transform:uppercase;
  color:var(--gray-700);
  margin-bottom:16px;
}
.section-head.center .section-label{ justify-content:center; }
.section-title{
  font-size:2.1rem;
  font-weight:600;
  letter-spacing:-0.02em;
  color:var(--ink);
  line-height:1.2;
  margin-bottom:14px;
}
.section-sub{ font-size:1.02rem; color:var(--gray-700); }

/* ============ BENEFÍCIOS ============ */
.benefits-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  border-top:1px solid var(--border);
  border-left:1px solid var(--border);
}
.benefit-card{
  padding:40px 32px;
  border-right:1px solid var(--border);
  border-bottom:1px solid var(--border);
  transition:background var(--ease);
}
.benefit-card:hover{ background:var(--gray-50); }
.benefit-index{
  font-family:'Space Grotesk', sans-serif;
  font-size:0.8rem;
  color:var(--gray-500);
  margin-bottom:24px;
}
.benefit-card h3{
  font-size:1.15rem;
  font-weight:600;
  margin-bottom:10px;
  color:var(--ink);
}
.benefit-card p{ color:var(--gray-700); font-size:0.95rem; }

/* ============ SOLUÇÕES ============ */
.solutions{ background:var(--ink); color:var(--paper); border-bottom:none; }
.solutions .section-label{ color:var(--teal); }
.solutions .section-title{ color:var(--paper); }
.solutions .section-sub{ color:rgba(255,255,255,0.65); }

.solutions-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:1px;
  background:rgba(255,255,255,0.14);
  margin-top:8px;
}
.solution-card{
  background:var(--ink);
  padding:36px 30px;
  transition:background var(--ease);
}
.solution-card:hover{ background:#141414; }
.solution-num{ font-size:0.8rem; color:var(--teal); margin-bottom:20px; }
.solution-card h3{ font-size:1.25rem; font-weight:600; margin-bottom:10px; }
.solution-card p{ color:rgba(255,255,255,0.65); font-size:0.92rem; margin-bottom:18px; }
.solution-tag{
  display:inline-block;
  font-size:0.75rem;
  font-weight:500;
  color:var(--teal);
  border:1px solid rgba(40,226,200,0.35);
  padding:5px 12px;
}

/* ============ DEPOIMENTOS ============ */
.testimonials-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  border-top:1px solid var(--border);
  border-left:1px solid var(--border);
}
.testimonial-card{
  padding:32px 28px;
  border-right:1px solid var(--border);
  border-bottom:1px solid var(--border);
  display:flex;
  flex-direction:column;
}
.stars{ color:var(--teal-dark); margin-bottom:16px; font-size:0.85rem; letter-spacing:3px; }
.testimonial-card blockquote{
  color:var(--ink);
  font-size:0.98rem;
  margin-bottom:24px;
  flex:1;
}
.testimonial-author{ display:flex; align-items:center; gap:12px; }
.avatar-square{
  width:38px; height:38px;
  background:var(--gray-100);
  display:flex; align-items:center; justify-content:center;
  font-family:'Space Grotesk', sans-serif;
  font-weight:600;
  font-size:0.9rem;
  color:var(--ink);
  flex-shrink:0;
}
.testimonial-author .name{ font-weight:600; font-size:0.92rem; }
.testimonial-author .role{ font-size:0.82rem; color:var(--gray-500); }

/* ============ FAQ ============ */
.faq-list{ max-width:720px; margin:0 auto; border-top:1px solid var(--border); }
.faq-item{ border-bottom:1px solid var(--border); }
.faq-question{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:20px;
  font-family:'Space Grotesk', sans-serif;
  font-weight:500;
  font-size:1.02rem;
  color:var(--ink);
  cursor:pointer;
  background:none;
  border:none;
  width:100%;
  text-align:left;
  padding:24px 4px;
}
.faq-question i{ transition:transform var(--ease); color:var(--gray-500); font-size:0.85rem; }
.faq-question.active i{ transform:rotate(45deg); }
.faq-answer{
  max-height:0;
  overflow:hidden;
  transition:max-height 0.25s ease;
  color:var(--gray-700);
  font-size:0.95rem;
}
.faq-answer.open{ max-height:200px; padding-bottom:24px; }

/* ============ GARANTIA ============ */
.guarantee-box{
  border:1px solid var(--border);
  padding:56px 40px;
  text-align:center;
  max-width:760px;
  margin:0 auto;
}
.guarantee-box .mark{ margin:0 auto 20px; }
.guarantee-box h2{ font-size:1.7rem; font-weight:600; margin-bottom:12px; }
.guarantee-box p{ color:var(--gray-700); max-width:480px; margin:0 auto 28px; }

/* ============ CTA FINAL ============ */
.cta-section{
  background:var(--ink);
  color:var(--paper);
  padding:80px 40px;
  text-align:center;
}
.cta-section h2{ font-size:2.1rem; font-weight:600; margin-bottom:14px; letter-spacing:-0.02em; }
.cta-section p{
  font-size:1.02rem;
  color:rgba(255,255,255,0.65);
  margin-bottom:32px;
  max-width:560px;
  margin-left:auto;
  margin-right:auto;
}
.cta-section .btn-primary{
  background:var(--teal);
  color:var(--ink);
  border-color:var(--teal);
}
.cta-section .btn-primary:hover{ background:var(--teal-dark); border-color:var(--teal-dark); }
.cta-note{ margin-top:22px; font-size:0.85rem; color:rgba(255,255,255,0.5); }

/* ============ RODAPÉ ============ */
footer{ padding:64px 0 28px; }
.footer-grid{
  display:grid;
  grid-template-columns:2fr 1fr 1fr 1fr;
  gap:40px;
  margin-bottom:56px;
}
.footer-brand .logo{ margin-bottom:14px; }
.footer-brand p{ color:var(--gray-700); max-width:280px; font-size:0.92rem; }
.footer-col h4{
  font-family:'Space Grotesk', sans-serif;
  font-weight:600;
  font-size:0.85rem;
  text-transform:uppercase;
  letter-spacing:0.06em;
  margin-bottom:18px;
}
.footer-col ul li{ margin-bottom:11px; }
.footer-col ul a{ color:var(--gray-700); font-size:0.92rem; transition:color var(--ease); }
.footer-col ul a:hover{ color:var(--ink); }
.footer-col ul li.plain{ color:var(--gray-700); font-size:0.92rem; display:flex; gap:8px; align-items:flex-start; }
.footer-bottom{
  border-top:1px solid var(--border);
  padding-top:24px;
  display:flex;
  justify-content:space-between;
  flex-wrap:wrap;
  gap:16px;
  font-size:0.85rem;
  color:var(--gray-500);
}
.footer-social{ display:flex; gap:20px; }
.footer-social a{ color:var(--gray-500); font-size:1rem; transition:color var(--ease); }
.footer-social a:hover{ color:var(--ink); }

/* ============ RESPONSIVO ============ */
@media (max-width:992px){
  .hero-grid{ grid-template-columns:1fr; }
  .hero-visual{ max-width:340px; margin:0 auto; }
  .hero-content{ text-align:center; }
  .hero-content p{ margin-left:auto; margin-right:auto; }
  .hero-buttons{ justify-content:center; }
  .eyebrow{ justify-content:center; }
  .benefits-grid,.solutions-grid,.testimonials-grid{ grid-template-columns:1fr 1fr; }
  .footer-grid{ grid-template-columns:1fr 1fr; }
}

@media (max-width:768px){
  .nav-links{
    display:none;
    flex-direction:column;
    align-items:flex-start;
    background:var(--paper);
    position:absolute;
    top:76px; left:0; width:100%;
    padding:32px 32px;
    border-bottom:1px solid var(--border);
    gap:20px;
  }
  .nav-links.open{ display:flex; }
  .menu-toggle{ display:block; }
  .nav-links .btn{ width:100%; justify-content:center; }

  .hero{ padding:60px 0 60px; }
  .hero-content h1{ font-size:2.3rem; }
  .section{ padding:64px 0; }
  .section-title{ font-size:1.7rem; }
  .benefits-grid,.solutions-grid,.testimonials-grid{ grid-template-columns:1fr; }
  .footer-grid{ grid-template-columns:1fr; gap:32px; }
  .footer-bottom{ flex-direction:column; align-items:flex-start; }
  .cta-section{ padding:56px 24px; }
  .cta-section h2{ font-size:1.6rem; }
}
